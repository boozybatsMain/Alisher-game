static func info(id: String) -> Dictionary:
	return WEAPONS.get(id, WEAPONS["sword"])


static func aspect_info(id: String, aspect: int) -> Dictionary:
	var a: Array = info(id)["aspects"]
	return a[clampi(aspect, 0, a.size() - 1)]


static func aspect_color(id: String, aspect: int) -> Color:
	return Color(String(aspect_info(id, aspect)["color"]))


static func title(id: String, aspect := 0) -> String:
	if aspect <= 0:
		return info(id)["title"]
	return "%s — %s" % [info(id)["title"], aspect_info(id, aspect)["title"]]
