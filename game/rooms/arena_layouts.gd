static func get_layout(id: String) -> Dictionary:
	return T.get(id, T["terraces"])


static func all_ids() -> Array:
	return T.keys()


## Шаблон для комнаты: босс → круглая арена; торговец/привал → караван-сарай; тайная → secret_trial;
## иначе случайный боевой по seed.
static func for_room(room: Dictionary) -> String:
	var t := String(room.get("type", "combat"))
	if t == "boss":
		return "boss_round"
	if t == "merchant" or t == "rest":
		return "caravan"
	if t == "secret":
		return "secret_trial"
	var rng := RandomNumberGenerator.new()
	rng.seed = int(room.get("seed", 0))
	return String(COMBAT[rng.randi_range(0, COMBAT.size() - 1)])
