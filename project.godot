; Engine configuration file.
config_version=5

[application]

config/name="Tamyr: Steppe of Ancestors"
config/description="2.5D action-roguelite: Кайсар, корни Байтерека, дары духов степи, акробатика и домбра."
run/main_scene="res://game/scenes/title.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.png"

[autoload]

Bus="*res://game/core/bus.gd"
Meta="*res://game/core/meta.gd"
Run="*res://game/core/run.gd"
Sfx="*res://game/core/sfx.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

